{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "firestore.rules"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(png|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
